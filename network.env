# Lighthouse source of the daisugi-devnet-0 dimhouse image, read by .github/workflows/docker.yml.
# The devnet runs ethpandaops/lighthouse:daisugi-devnet-0: Lighthouse v8.2.2 plus the
# asanso/AA-PQ eip8288-lean series. LIGHTHOUSE_REF=daisugi-devnet-0 makes docker.yml build it
# with scripts/prepare-daisugi-source.sh, which pins both.
NETWORK=daisugi-devnet-0
LIGHTHOUSE_REPO=sigp/lighthouse
LIGHTHOUSE_REF=daisugi-devnet-0
LIGHTHOUSE_COMMIT=
