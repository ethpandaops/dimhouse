+/// Compressed sizes of recently decompressed gossip messages, keyed by `compressed_size_key`.
+static COMPRESSED_SIZES: LazyLock<Mutex<CompressedSizes>> = LazyLock::new(Mutex::default);
+
+const COMPRESSED_SIZES_LEN: usize = 8192;
+/// Bytes hashed from each end of a message when keying its compressed size.
+const COMPRESSED_SIZE_KEY_SPAN: usize = 4096;
+
+#[derive(Default)]
+struct CompressedSizes {
+    sizes: HashMap<u64, usize>,
+    order: VecDeque<u64>,
+}
+
+fn compressed_size_key(topic: &TopicHash, data: &[u8]) -> u64 {
+    let mut hasher = DefaultHasher::new();
+    topic.hash(&mut hasher);
+    data.len().hash(&mut hasher);
+    data[..data.len().min(COMPRESSED_SIZE_KEY_SPAN)].hash(&mut hasher);
+    data[data.len().saturating_sub(COMPRESSED_SIZE_KEY_SPAN)..].hash(&mut hasher);
+    hasher.finish()
+}
+
+fn record_compressed_size(topic: &TopicHash, data: &[u8], compressed_size: usize) {
+    let key = compressed_size_key(topic, data);
+    let mut cache = COMPRESSED_SIZES.lock();
+    if cache.sizes.insert(key, compressed_size).is_none() {
+        cache.order.push_back(key);
+        if cache.order.len() > COMPRESSED_SIZES_LEN
+            && let Some(oldest) = cache.order.pop_front()
+        {
+            cache.sizes.remove(&oldest);
+        }
+    }
+}
+
+/// Returns the compressed size of the gossip message that decompressed to `data` on `topic`.
+pub fn get_compressed_size(topic: &TopicHash, data: &[u8]) -> Option<usize> {
+    let key = compressed_size_key(topic, data);
+    COMPRESSED_SIZES.lock().sizes.get(&key).copied()
+}
